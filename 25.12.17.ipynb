   "source": [
    "#[평균]\n",
    "\n",
    "n = int(input())\n",
    "\n",
    "scores = list(map(int, input().split()))\n",
    "\n",
    "m = max(scores)\n",
    "\n",
    "new_avg = (sum(scores) * 100) / (m * n)\n",
    "\n",
    "print(new_avg)"
   ]
